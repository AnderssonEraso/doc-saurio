# ==============================================================================
# NOVAMED - SUPABASE CONFIGURATION
# ==============================================================================
# Copia este archivo como .env y completa con las credenciales de tu proyecto Supabase:
# cp .env.example .env
# ==============================================================================

# 1. Project Reference ID
# Lo encuentras en la URL de tu proyecto en el dashboard:
# https://supabase.com/dashboard/project/<PROJECT_ID> o en Project Settings > General
SUPABASE_PROJECT_ID=tu_project_ref_id_aqui

# 2. Supabase API Credentials (Project Settings > API)
# URL pública de tu API de Supabase
SUPABASE_URL=https://tu_project_ref_id_aqui.supabase.co
PUBLIC_SUPABASE_URL=https://tu_project_ref_id_aqui.supabase.co

# Clave pública / anónima (segura para usar en el frontend de Angular)
SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui
PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# 3. Database Credentials (Project Settings > Database)
# Contraseña asignada al crear la base de datos de Supabase (necesaria para `supabase link`)
SUPABASE_DB_PASSWORD=tu_password_de_base_de_datos

# Cadena de conexión directa (opcional si usas herramientas externas o migraciones directas)
# Formato: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:tu_password_de_base_de_datos@db.tu_project_ref_id_aqui.supabase.co:5432/postgres
